# ============================================================
#  Inspecteur Gadget — Configuration d'environnement
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  NE JAMAIS committer le fichier `.env` (voir .gitignore).
# ============================================================

# --- Obligatoire ---------------------------------------------
# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application / Client ID du bot (Developer Portal > General Information)
CLIENT_ID=

# --- Déploiement des commandes -------------------------------
# ID du serveur de test. Si défini, `npm run deploy` enregistre
# les slash commands uniquement sur ce serveur (mise à jour
# instantanée). Laisser vide pour un déploiement global (lent).
DEV_GUILD_ID=

# --- Propriétaires / administrateurs du bot ------------------
# Liste d'IDs Discord séparés par des virgules autorisés à
# utiliser les commandes propriétaire (ex: 123,456)
OWNER_IDS=

# --- Base de données -----------------------------------------
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/gadget.sqlite

# --- Sauvegardes de la base ----------------------------------
# Dossier des sauvegardes SQLite (`npm run backup:db` et sauvegarde
# automatique). Vide = <dossier de la base>/backups (ex : data/backups).
DB_BACKUP_DIR=
# Nombre de sauvegardes conservées (les plus anciennes sont supprimées).
DB_BACKUP_KEEP=14
# Sauvegarde automatique dans le processus du bot, toutes les N heures
# (ex : 24 pour une sauvegarde quotidienne, max 576). Vide = désactivée.
DB_BACKUP_INTERVAL_HOURS=

# --- Supervision (healthcheck HTTP) ---------------------------
# Port du serveur HTTP de supervision : GET /healthz (200 si le bot est
# connecté et la base répond, 503 sinon) et GET /metrics (Prometheus).
# Vide = serveur désactivé. L'image Docker utilise 8080.
HEALTH_PORT=
# Adresse d'écoute. 127.0.0.1 = accessible depuis la machine seulement ;
# 0.0.0.0 dans un conteneur (publiez alors le port sur 127.0.0.1 de l'hôte).
HEALTH_HOST=127.0.0.1

# --- Flux RSS / YouTube (/flux) ------------------------------
# Seule fonction qui fait des requêtes HTTP sortantes (délai 10 s, 1 Mo max,
# adresses privées refusées). off = lecture des flux désactivée.
FEEDS_NETWORK=

# --- Présence du bot (statuts tournants, tous les serveurs) ---
# Statuts séparés par « | », chacun « type:texte » (types : joue, regarde,
# écoute ; sans type : regarde). Variables : {serveurs} {membres}.
# Vide = statuts par défaut (/help, nombre de serveurs, /projet, membres).
# Exemple : regarde:/help • {serveurs} serveurs | joue:/projet | écoute:{membres} membres
PRESENCE_STATUSES=
# Rotation des statuts, en minutes (1 au minimum, 1440 au maximum).
PRESENCE_INTERVAL_MINUTES=1

# --- Divers --------------------------------------------------
# Niveau de log: error | warn | info | debug
LOG_LEVEL=info

# Format des logs : text (lisible, coloré) | json (une ligne JSON par
# entrée : time, level, scope, msg, err — pour Loki, ELK, Datadog...)
LOG_FORMAT=text

# Environnement: development | production
NODE_ENV=development
