# ============================================================
#  Inspecteur Gadget — Configuration d'environnement
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  NE JAMAIS committer le fichier `.env` (voir .gitignore).
# ============================================================

# --- Obligatoire ---------------------------------------------
# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application / Client ID du bot (Developer Portal > General Information)
CLIENT_ID=

# --- Déploiement des commandes -------------------------------
# ID du serveur de test. Si défini, `npm run deploy` enregistre
# les slash commands uniquement sur ce serveur (mise à jour
# instantanée). Laisser vide pour un déploiement global (lent).
DEV_GUILD_ID=

# --- Propriétaires / administrateurs du bot ------------------
# Liste d'IDs Discord séparés par des virgules autorisés à
# utiliser les commandes propriétaire (ex: 123,456)
OWNER_IDS=

# --- Base de données -----------------------------------------
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/gadget.sqlite

# --- Divers --------------------------------------------------
# Niveau de log: error | warn | info | debug
LOG_LEVEL=info

# Environnement: development | production
NODE_ENV=development
