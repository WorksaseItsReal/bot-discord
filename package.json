{
  "name": "inspecteur-gadget-bot",
  "version": "0.2.0",
  "description": "Inspecteur Gadget — bot Discord de gestion tout-en-un (modération, sécurité, automod, antiraid, logs, tickets, giveaways, utilitaires) construit avec discord.js.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy-commands.js",
    "deploy:global": "node scripts/deploy-commands.js --global",
    "check": "node scripts/healthcheck.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "moderation",
    "security",
    "automod",
    "antiraid"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
